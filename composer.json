{
    "name": "laravelplus/content-security",
    "description": "Defense-in-depth content security for Laravel: malware scanning, MIME/magic-byte verification, archive/image/PDF inspection, HTML sanitization, URL/SSRF checks, quarantine, audit trail and a Vue 3 security console.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "clamav",
        "malware",
        "upload",
        "sanitizer",
        "quarantine",
        "inertia",
        "vue"
    ],
    "authors": [
        {
            "name": "Nejc Cotič",
            "email": "nejc.cotic@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "laravel/framework": "^13.0",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "suggest": {
        "ext-zip": "Required to inspect ZIP archives (zip bombs, path traversal, embedded executables).",
        "ext-gd": "Required to validate and re-encode images.",
        "inertiajs/inertia-laravel": "Required for the /admin/content-security console."
    },
    "autoload": {
        "psr-4": {
            "LaravelPlus\\ContentSecurity\\": "src/",
            "LaravelPlus\\ContentSecurity\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPlus\\ContentSecurity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPlus\\ContentSecurity\\ContentSecurityServiceProvider"
            ],
            "aliases": {
                "ContentSecurity": "LaravelPlus\\ContentSecurity\\Facades\\ContentSecurity"
            }
        }
    },
    "scripts": {
        "test": "pest --testsuite=Unit,Feature",
        "analyse": "phpstan analyse",
        "lint": "pint --parallel",
        "lint:check": "pint --parallel --test",
        "test:integration": "pest --testsuite=Integration",
        "_comment_testbench_symlink": "orchestra/testbench symlinks its app skeleton's vendor back at this package's own vendor. The loop is harmless to PHP, but any tool that globs the host application (eslint, prettier, IDE indexers) walks it until ELOOP and dies. The tests pass without it, so it is removed after every install.",
        "post-install-cmd": [
            "@php -r \"@unlink('vendor/orchestra/testbench-core/laravel/vendor');\""
        ],
        "post-update-cmd": [
            "@php -r \"@unlink('vendor/orchestra/testbench-core/laravel/vendor');\""
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
